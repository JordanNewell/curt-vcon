{
  "name": "curt-vcon",
  "version": "1.0.1",
  "description": "Bidirectional converter between the .curt AI-conversation format and the IETF vCon container",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "curt-vcon": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && vitest run",
    "prepack": "npm run build"
  },
  "keywords": [
    "curt",
    "vcon",
    "ietf",
    "conversation",
    "converter",
    "interoperability"
  ],
  "dependencies": {
    "curt-format": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "repository": {
    "url": "https://github.com/JordanNewell/curt-vcon.git",
    "type": "git"
  },
  "homepage": "https://github.com/JordanNewell/curt-vcon#readme",
  "bugs": {
    "url": "https://github.com/JordanNewell/curt-vcon/issues"
  }
}
